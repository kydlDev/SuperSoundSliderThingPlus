{
    "name":  "feature-toggle",
    "description":  "Enable Mod off stops every feature, on starts them again (PROJECT_RULES 11, spec 4). The mod has no feature tab (user, 2026-11-17): its four config tabs stay in the hub either way and no Sound tab comes back",
    "timeout":  60,
    "steps":  [
                  {
                      "do":  "hook",
                      "name":  "SuperSoundSliderThingPlus.arena",
                      "contains":  "arena at",
                      "label":  "start on the arena spot"
                  },
                  {
                      "do":  "hook",
                      "name":  "SuperSoundSliderThingPlus.featureRunning",
                      "args":  {
                                   "id":  "sound"
                               },
                      "expect":  true,
                      "label":  "running at start"
                  },
                  {
                      "do":  "hook",
                      "name":  "kc.hubTabCount",
                      "expect":  4,
                      "label":  "4 config tabs, no feature tab (tab registered)",
                      "args":  {
                                   "mod":  "com.kydldev.SuperSoundSliderThingPlus"
                               }
                  },
                  {
                      "do":  "setConfig",
                      "values":  {
                                     "General/Enable Mod":  false
                                 }
                  },
                  {
                      "do":  "wait",
                      "until":  {
                                    "check":  "hook",
                                    "name":  "SuperSoundSliderThingPlus.featureRunning",
                                    "args":  {
                                                 "id":  "sound"
                                             },
                                    "expect":  false
                                },
                      "timeout":  5
                  },
                  {
                      "do":  "hook",
                      "name":  "kc.hubTabCount",
                      "expect":  4,
                      "label":  "4 config tabs, no feature tab (tab removed while off)",
                      "args":  {
                                   "mod":  "com.kydldev.SuperSoundSliderThingPlus"
                               }
                  },
                  {
                      "do":  "setConfig",
                      "values":  {
                                     "General/Enable Mod":  true
                                 }
                  },
                  {
                      "do":  "wait",
                      "until":  {
                                    "check":  "hook",
                                    "name":  "SuperSoundSliderThingPlus.featureRunning",
                                    "args":  {
                                                 "id":  "sound"
                                             },
                                    "expect":  true
                                },
                      "timeout":  5
                  },
                  {
                      "do":  "hook",
                      "name":  "kc.hubTabCount",
                      "expect":  4,
                      "label":  "4 config tabs, no feature tab (tab back)",
                      "args":  {
                                   "mod":  "com.kydldev.SuperSoundSliderThingPlus"
                               }
                  }
              ],
    "asserts":  [
                    {
                        "check":  "noErrors",
                        "source":  "SuperSoundSliderThingPlus"
                    }
                ]
}
